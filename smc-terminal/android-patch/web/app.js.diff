+// TradingView ticker tape: a symbol click comes back as #tv?tvwidgetsymbol=EXCHANGE:TICKER (largeChartUrl) and opens
+// the app's chart page of that asset; the #tv entry itself is not kept in the history.
+function tradingViewRoute() {
+  const m = /^#tv\?(.*)$/.exec(location.hash);
+  if (!m) return false;
+  const symbol = new URLSearchParams(m[1]).get('tvwidgetsymbol');
+  const back = readPref('route', '#dashboard');
+  history.replaceState(null, '', back && !back.startsWith('#tv') ? back : '#dashboard');
+  if (symbol) openAnalysis(symbol, '1h');
+  else route();
+  return true;
+}
+
 function route() {
+  if (tradingViewRoute()) return;
   const [name = 'dashboard', ...params] = location.hash.replace(/^#/, '').split('/').map(decodeURIComponent);
