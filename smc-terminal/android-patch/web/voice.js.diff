+  /** A page opened in the reader: its text (taken from the rendered page) is read aloud, then the AI analyses that
+   *  same text (the engine keeps it as the article of this news item). */
+  async handleReader(job, active) {
+    const item = job.item || {};
+    const symbol = item.id ? newsSymbol(item) : (item.symbols?.[0]?.symbol || null);
+    const text = String(job.text || '');
+    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
+    let site = '';
+    try { site = new URL(job.finalUrl || item.link).hostname.replace(/^www\./, ''); } catch { /* unknown */ }
+    if (symbol) { await this.navigateChart(symbol, active); if (!active()) return false; }
+    this.showCard({ ...item, title: item.title || job.title }, job.mode === 'analyze' ? 'AI menganalisa halaman yang dibuka' : 'membacakan berita dari halaman yang dibuka');
+    this.cardLine(`<div class="va-news"><div class="va-src"><span><span class="tag info">HALAMAN DIBUKA</span> ${esc(job.title || item.title || '')}</span>
+      <span class="dim">${words.toLocaleString('id-ID')} kata diambil dari ${esc(site)}</span></div></div>`);
+    this.cardActions('<button class="btn danger" data-va="stop" title="Hentikan bacaan dan kosongkan antrean">STOP SEMUA</button>');
+    let kept = null;
+    if (item.link) {
+      try {
+        kept = await api('/api/news/article-text', { json: { id: item.id || null, item: item.id ? item : null, acceptedAt: (job.at || Date.now()) / 1000,
+          url: item.link, finalUrl: job.finalUrl, title: job.title, itemTitle: item.title || '', text } });
+      } catch (e) { kept = { ok: false, reason: e.message }; }
+    }
+    if (!active()) return false;
+    const controller = new AbortController();
+    this.analysisController = controller;
+    const analysis = job.mode !== 'speak' && item.id && symbol
+      ? api('/api/ai/news', { signal: controller.signal, json: { id: item.id, item, acceptedAt: (job.at || Date.now()) / 1000, symbol, fast: true } })
+        .catch((e) => ({ failed: e.message, symbol, aiError: { retryAfterSeconds: e.body?.retryAfterSeconds ?? (e.status === 0 || e.status >= 500 ? 60 : null) } }))
+      : null;
+    try {
+      if (job.mode !== 'analyze') {
