+def _pace(deadline: float) -> None:
+    """Waits until one more request fits in the rolling minute (PACE_PER_MIN), within the deadline."""
+    while True:
+        with _lock:
+            now = time.monotonic()
+            while _sent and now - _sent[0] >= 60:
+                _sent.pop(0)
+            if len(_sent) < PACE_PER_MIN:
+                _sent.append(now)
+                return
+            wait = 60 - (now - _sent[0]) + 0.05
+        if time.monotonic() + wait > deadline - 15:
+            error = AiFailed("Batas permintaan per menit model gratis OpenRouter (±20/menit) sedang penuh; dicoba lagi sebentar lagi.")
+            error.retry_after = int(wait) + 1
+            raise error
+        time.sleep(min(wait, 5))
+
+
+def _reset_at(result: ChatResult) -> float | None:
+    headers = (result.meta or {}).get("headers") or {}
+    reset = headers.get("X-RateLimit-Reset") or headers.get("x-ratelimit-reset")
+    try:
+        value = int(reset) / 1000
+    except (TypeError, ValueError):
+        return None
+    return value if value > time.time() else None
 
 
