+SOURCE_TTL=15*60
+SOURCE_TEXT_CHARS,SOURCE_TEXT_TOTAL,SOURCE_FETCH=3000,18000,6
+_sources_cache={}
+_sources_lock=threading.Lock()
+
+def sources_for(event,news,evidence=related_news):
+    """The public sources of a calendar analysis, listed once per event for 15 minutes: the app opens their pages first
+    (to take their text) and the analysis then uses the same sources with that text."""
+    key=str(event.get('id') or event.get('title') or '')
+    with _sources_lock:
+        hit=_sources_cache.get(key)
+        if hit and hit[0]>time.time():return hit[1]
+    rows=evidence(event,news)
+    with _sources_lock:
+        _sources_cache[key]=(time.time()+SOURCE_TTL,rows)
+        for k in [k for k,(until,_) in _sources_cache.items() if until<time.time()]:_sources_cache.pop(k,None)
+    return rows
+
+def with_texts(sources,retrieve=None,cached=None):
+    """Adds each source's article text: the text the app took from the opened page (cache of article_retrieval),
+    else a quick plain-HTTP fetch for the first sources still without one. Bounded per source and in total."""
+    from . import article_retrieval
+    cached=cached or (lambda url:article_retrieval.store().cached(url))
+    retrieve=retrieve or (lambda s:article_retrieval.retrieve(s['link'],s.get('title',''),s.get('summary',''),item={},budget=8,browser=lambda *a,**k:None))
+    def text_of(value):
+        return value.get('text','') if value and value.get('source')=='article' and value.get('complete') else ''
+    texts={s['id']:text_of(cached(s['link'])) for s in sources}
+    missing=[s for s in sources if not texts[s['id']]][:SOURCE_FETCH]
+    if missing:
+        with ThreadPoolExecutor(max_workers=4) as pool:
+            for s,value in zip(missing,pool.map(lambda s:_safe(retrieve,s),missing)):texts[s['id']]=text_of(value)
+    out=[];total=0
+    for s in sources:
+        text=texts.get(s['id'],'')[:max(0,min(SOURCE_TEXT_CHARS,SOURCE_TEXT_TOTAL-total))]
+        total+=len(text)
+        out.append({**s,'text':text,'scope':'public_article_text'} if text else s)
+    return out
+
+def _safe(fn,arg):
+    try:return fn(arg)
+    except Exception:return None
+
