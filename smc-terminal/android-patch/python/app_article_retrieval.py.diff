+def browser_fetch(url,title='',timeout=25):
+    """The article as a browser renders it: the Android host loads the page in a hidden WebView (normal WebView
+    user agent; the page's own scripts run, e.g. the Google News redirect) and returns its readable text. Pages that
+    show a bot check or captcha are left unread. None without a host browser (desktop, tests)."""
+    try:
+        from java import jclass
+    except ImportError:
+        return None
+    try:raw=jclass('com.sharx.invest.ReaderHooks').fetch(url,title or '',int(timeout*1000))
+    except Exception:return None
+    if raw is None:return None
+    try:
+        page=json.loads(str(raw))
+        return page if isinstance(page,dict) else None
+    except ValueError:return None
