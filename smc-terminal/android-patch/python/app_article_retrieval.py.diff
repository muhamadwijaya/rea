+def same_title(expected,actual,need=.35):
+    """True unless both titles are known and share too few words (a different page than the news item)."""
+    words=set(re.findall(r'\w+',(expected or '').lower()))-_stop
+    if len(words)<4 or not actual:return True
+    return len(words&set(re.findall(r'\w+',actual.lower())))/len(words)>=need
