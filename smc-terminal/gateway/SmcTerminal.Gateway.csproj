<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmcTerminal.Gateway</RootNamespace>
    <AssemblyName>SmcTerminal.Gateway</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Run on .NET 8 or any newer installed runtime. -->
    <RollForward>Major</RollForward>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Encrypts the saved Anthropic API key with the Windows user's DPAPI key. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
